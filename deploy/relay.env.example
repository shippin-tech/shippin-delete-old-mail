# Outbound smarthost. Off sends remote mail by MX lookup. On sends the sender
# domains below through RELAY_HOST and leaves every other domain on MX.
# Apply with: bash relay.sh apply
# Turn on:    bash relay.sh enable
# Turn off:   bash relay.sh disable
RELAY=off

# Comma-separated sender domains. Required when RELAY=on. Example: example.com
RELAY_DOMAINS=

# Any SMTP smarthost. The documented example is Resend:
#   RELAY_HOST=smtp.resend.com
#   RELAY_PORT=465
#   RELAY_IMPLICIT_TLS=true
#   RELAY_USERNAME=resend
# Paste Resend's API key into secrets/relay/relay.key (mode 400). The file is
# the secret. Do not put the key in this file.
RELAY_HOST=
RELAY_PORT=465
RELAY_IMPLICIT_TLS=true
RELAY_USERNAME=
# Registry name of the route. Lowercase, no spaces.
RELAY_NAME=relay
