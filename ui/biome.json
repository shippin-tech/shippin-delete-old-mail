{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"root": ".."
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"src/**",
			"test/**",
			"scripts/**",
			"e2e/**",
			"e2e-live/**",
			"!**/*.svelte",
			"!**/generated",
			"!**/*.html",
			"!**/portal/catalog.ts",
			"!**/*.generated.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 110,
		"lineEnding": "lf"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"useTemplate": "off",
				"noNonNullAssertion": "off"
			},
			"suspicious": {
				"noThenProperty": "off"
			},
			"correctness": {
				"usePlaywrightValidDescribeCallback": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"trailingCommas": "none"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
